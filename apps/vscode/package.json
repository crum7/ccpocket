{
  "name": "@ccpocket/vscode",
  "displayName": "CC Pocket",
  "description": "VSCode panel for the CC Pocket bridge — Claude Code/Codex sessions inside an editor tab",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "K9i",
  "publisher": "ccpocket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/K9i-0/ccpocket.git",
    "directory": "apps/vscode"
  },
  "main": "dist/extension.js",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ccpocket.open",
        "title": "CC Pocket: Open Panel",
        "category": "CC Pocket"
      }
    ],
    "configuration": {
      "title": "CC Pocket",
      "properties": {
        "ccpocket.bridgeUrl": {
          "type": "string",
          "default": "ws://localhost:8765",
          "description": "WebSocket URL of the local CC Pocket bridge server"
        },
        "ccpocket.bridgeToken": {
          "type": "string",
          "default": "",
          "description": "Optional API key if the bridge was started with BRIDGE_API_KEY"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node22 --external:vscode --format=cjs --outfile=dist/extension.js",
    "watch": "npm run build -- --watch --sourcemap",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && code --extensionDevelopmentPath=\"$PWD\" --new-window",
    "vscode:prepublish": "npm run build -- --minify"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
